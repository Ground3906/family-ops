    },
    {
      "item": "garlic, finely chopped",
      "qty": "8",
      "unit": "cloves",
      "note": null
    },
    {
      "item": "dried oregano",
      "qty": "1",
      "unit": "tsp",
      "note": null
    },
    {
      "item": "dried basil",
      "qty": "1",
      "unit": "tsp",
      "note": null
    },
    {
      "item": "sea salt",
      "qty": "\u00bd",
      "unit": "tsp",
      "note": null
    },
    {
      "item": "ground black pepper",
      "qty": "\u00bd",
      "unit": "tsp",
      "note": null
    },
    {
      "item": "medium zucchini, cut into \u00bd-inch slices",
      "qty": "8",
      "unit": null,
